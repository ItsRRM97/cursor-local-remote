# Auth token for remote access. If unset, a random token is generated each launch.
# AUTH_TOKEN=my-secret-token

# Public URL (internet). Used for webhook deep links and /api/info.
# PUBLIC_URL=https://clr.example.com

# Cloudflare Access — skip CLR token when Cf-Access-Jwt-Assertion validates.
# AUTH_TRUST_CLOUDFLARE_ACCESS=1
# CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# CF_ACCESS_AUD=<access-app-aud-from-zero-trust-dashboard>

# Extra folders for the project picker (colon-separated). Default: ~/Projects if it exists.
# CLR_PROJECT_ROOTS=/path/to/repos:/other/path

# Override MCP workspace for headless OAuth (optional).
# CLR_MCP_WORKSPACE=/path/to/project-with-mcp-auth

# Workspace path for Cursor. Defaults to ~/.cursor-local-remote/no-folder when unset.
# CURSOR_WORKSPACE=/path/to/your/project

# Pass --trust to the agent CLI (skips confirmation prompts).
# CURSOR_TRUST=1

# Server port (default: 3100).
# PORT=3100
